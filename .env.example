# -- LLM Provider --
ANTHROPIC_API_KEY=your-anthropic-api-key

# -- LangSmith Tracing (optional but recommended) --
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=faceless

# -- MCP Tools (optional, only needed for the MCPs you select) --
# github MCP — @modelcontextprotocol/server-github
# Create a classic PAT at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token

# search MCP — tavily-mcp
# Get a free key at: https://app.tavily.com
TAVILY_API_KEY=tvly_your_tavily_key
